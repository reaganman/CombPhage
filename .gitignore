tignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environments
.env
.venv/
venv/
env/

# Streamlit secrets
.streamlit/secrets.toml

# CombPhage generated data
combphage_runs/
genbanks/
prepped_genbanks/
feature_overlaps/
results*/
mmseqs/

# Logs
*.log

# OS/editor files
.DS_Store
.vscode/
.idea/
EOF
